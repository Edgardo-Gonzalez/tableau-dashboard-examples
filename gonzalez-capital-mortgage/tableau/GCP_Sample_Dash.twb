      <column caption='Completed Loan' datatype='boolean' name='[Calculation_1239455842934785]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[status] = &apos;Funded&apos;' />
      </column>
      <column caption='Valid Duration Loan' datatype='boolean' name='[Calculation_1239455843000322]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Calculation_1239455842934785] AND [has_timestamp_anomaly] = 0' />
      </column>
      <column caption='Fallout Dollars' datatype='real' name='[Calculation_1239455843074051]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='If [status] = &apos;Fallout&apos; THEN [loan_amount] END' />
      </column>
      <column caption='Application Month' datatype='datetime' name='[Calculation_1239455843229700]' role='dimension' type='ordinal'>
