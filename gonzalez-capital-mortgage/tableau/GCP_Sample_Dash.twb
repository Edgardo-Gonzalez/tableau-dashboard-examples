      <column caption='Rural Delay Share' datatype='real' name='[Calculation_1239455844630534]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [market_tier] = &apos;Rural&apos; THEN [days_appraisal_wait] END) / SUM([days_appraisal_wait])' />
      </column>
